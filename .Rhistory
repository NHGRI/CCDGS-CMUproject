if (is.null(sample_sheet_path)) { message("  Skipping: Sample sheet missing."); next }
# Find clinical file dynamically
cancer_dir <- dirname(paired_df$Data_Path[i])
clinical_files <- list.files(cancer_dir, pattern = "clinical.*\\.tsv", full.names = TRUE)
if (length(clinical_files) == 0) { message("  Skipping: Clinical file missing."); next }
clinical_path_dynamic <- clinical_files[1]
# Generate full list from sheet
project_id <- paste0("TCGA-", current_cancer)
cov_data <- generate_tcga_covariates(sample_sheet_path, clinical_path_dynamic, project_id)
if (is.null(cov_data$Control) || is.null(cov_data$Case)) { message("  Skipping: Metadata generation failed."); next }
# COMBINE & FILTER SEX
X_Combined <- rbind(cov_data$Control, cov_data$Case)
sex_filter_mode <- NULL
if (current_cancer %in% female_cancers) {
sex_filter_mode <- "FemaleOnly"
X_Combined <- X_Combined[, c("intercept", "Age_sampling_Y"), drop=FALSE]
} else if (current_cancer %in% male_cancers) {
sex_filter_mode <- "MaleOnly"
X_Combined <- X_Combined[, c("intercept", "Age_sampling_Y"), drop=FALSE]
}
# Indices (Now guaranteed to match file dimensions)
idx_ctrl_X <- 1:nrow(cov_data$Control)
idx_case_X <- (nrow(cov_data$Control) + 1):(nrow(cov_data$Control) + nrow(cov_data$Case))
path_data_ctrl
path_data_case
functionArguments[[idx_ctrl_list]]$indexFile
functionArguments[[idx_case_list]]$indexFile
idx_ctrl_X
idx_case_X
path_index_ctrl <- functionArguments[[idx_ctrl_list]]$indexFile
path_index_ctrl
path_index_case <- functionArguments[[idx_case_list]]$indexFile
X_Combined
head(X_Combined)
