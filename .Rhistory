male_cancers   <- c("PRAD", "TGCT")
# Find 11 tissues that have solid and primary
find_paired_indices <- function(args_list) {
library(dplyr)
inventory <- lapply(seq_along(args_list), function(i) {
path <- args_list[[i]]$data
if (is.null(path)) return(NULL)
fname <- basename(path)
# Extract Cancer Code
cancer <- sub(".*TCGA-([A-Z]+).*", "\\1", fname)
type <- "Unknown"
if (grepl("Solid", fname, ignore.case = TRUE)) type <- "Control"
if (grepl("Primary", fname, ignore.case = TRUE)) type <- "Case"
return(data.frame(
Index = i,
Cancer = cancer,
Type = type,
Path = path,
stringsAsFactors = FALSE
))
})
df <- do.call(rbind, inventory)
# Return complete pairs
pairs <- df %>%
filter(Type %in% c("Control", "Case")) %>%
group_by(Cancer) %>%
filter(n_distinct(Type) == 2) %>%
summarise(
Control_Index = Index[Type == "Control"],
Case_Index = Index[Type == "Case"],
Data_Path = Path[Type == "Control"] # Now this will work
) %>%
arrange(Cancer)
return(pairs)
}
# FIND NEWEST SAMPLE SHEET is multiple in file
get_newest_sheet <- function(data_file_path) {
# 1. Determine the Cancer Directory (Parent folder of the data file)
cancer_dir <- dirname(data_file_path)
# 2. List all sample sheets matching "gdc_sample_sheet.YYYY-MM-DD.tsv"
sheets <- list.files(cancer_dir, pattern = "gdc_sample_sheet.*\\.tsv", full.names = TRUE)
if (length(sheets) == 0) {
warning(paste("No sample sheet found in:", cancer_dir))
return(NULL)
}
# 3. Sort by Name (Since YYYY-MM-DD sorts alphabetically correctly)
# tail(..., 1) gets the last one (newest date)
newest_sheet <- tail(sort(sheets), 1)
message(paste("  Using Sample Sheet:", basename(newest_sheet)))
return(newest_sheet)
}
# GENERATE COVARIATES
generate_tcga_covariates <- function(sample_sheet_path, clinical_path, project_filter) {
library(data.table)
sheet <- fread(sample_sheet_path, sep="\t", quote="", header=TRUE, check.names=FALSE)
clinical <- fread(clinical_path, sep="\t", quote="", header=TRUE, check.names=FALSE)
sheet <- sheet[grep(project_filter, sheet$`Project ID`), ]
controls_ordered <- sheet[grep("Solid", sheet$`Sample Type`), ]
cases_ordered    <- sheet[grep("Primary", sheet$`Sample Type`), ]
get_cov_matrix <- function(sheet_subset, clinical_df) {
if(nrow(sheet_subset) == 0) return(NULL)
match_idx <- match(sheet_subset$`Case ID`, clinical_df$submitter_id)
matched_data <- clinical_df[match_idx, ]
if ("age_at_diagnosis" %in% colnames(matched_data)) {
age <- as.numeric(matched_data$age_at_diagnosis) / 365.25
} else {
age <- abs(as.numeric(matched_data$days_to_birth)) / 365.25
}
gender <- as.numeric(as.factor(matched_data$gender)) - 1
return(data.frame(intercept=1, Gender=gender, Age_sampling_Y=round(age, 1)))
}
return(list(Control = get_cov_matrix(controls_ordered, clinical),
Case    = get_cov_matrix(cases_ordered, clinical)))
}
# Helper to count columns quickly (reading first line only)
count_file_cols <- function(fpath) {
if (!file.exists(fpath)) return(0)
# Read the first TWO lines
# fill=TRUE ensures we don't crash if lengths differ
lines_dt <- fread(fpath, nrows = 2, header = FALSE, sep = " ", quote = "", fill = TRUE)
if (nrow(lines_dt) < 2) return(0) # File too short
cols_row1 <- sum(!is.na(lines_dt[1, ])) # Count non-NA columns in header
cols_row2 <- sum(!is.na(lines_dt[2, ])) # Count non-NA columns in data
# LOGIC:
# If Data row is longer than Header row (by 1), it's an Offset File.
# The Header count is the pure sample count.
if (cols_row2 > cols_row1) {
return(cols_row1)
} else {
# Otherwise, it's a standard file (First col is ID), so subtract 1.
return(cols_row1 - 1)
}
}
